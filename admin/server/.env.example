NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://your-admin-domain.example
# Comma-separated reverse-proxy socket IPs allowed to provide x-real-ip/x-forwarded-for.
# TRUSTED_PROXY=127.0.0.1
# Configure each mini program's AppID and AppSecret in the admin panel.
PUBLIC_MINIAPP_API_BASE_URL=https://your-api-domain.example/api
# Absolute path to the deployed miniprogram source. Upload keys are stored under MINIAPP_DATA_DIR.
# MINIPROGRAM_SOURCE_DIR=/app/miniprogram
