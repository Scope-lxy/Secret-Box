NODE_ENV=production
PORT=3101
MINIAPP_DATA_DIR=/app/data
MINIAPP_DATABASE_FILE=/app/data/secretbox.sqlite
# Backups are operator-managed and must be outside the active data volume.
MINIAPP_BACKUP_DIR=/app/backups
CORS_ORIGIN=https://secretbox.scopeview.cn
PUBLIC_BASE_URL=https://secretbox.scopeview.cn
PUBLIC_MINIAPP_API_BASE_URL=https://secretbox.scopeview.cn/api
MINIPROGRAM_SOURCE_DIR=/app/miniprogram

# Configure each mini program's AppID and AppSecret in the admin panel.
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=
# COS_REGION=
