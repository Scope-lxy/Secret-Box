.theme {
  --color-bg: #f6efe6;
  --color-card: #fffaf2;
  --color-card-soft: #fff6eb;
  --color-message-bg: rgba(212, 154, 104, 0.10);
  --color-message-border: rgba(212, 154, 104, 0.18);
  --color-text: #493829;
  --color-text-secondary: #8b7461;
  --color-text-hint: #b69c83;
  --color-line: rgba(112, 78, 46, 0.14);
  --color-line-soft: rgba(112, 78, 46, 0.10);
  --color-accent: #d49a68;
  --color-accent-dark: #a66b42;
  --color-accent-soft: rgba(212, 154, 104, 0.14);
  --color-danger: #fa5151;
  --color-white: #fff;
  --type-tab: 22rpx;
  --type-caption: 24rpx;
  --type-article-meta: 26rpx;
  --type-assist: 26rpx;
  --type-control: 30rpx;
  --type-action: 26rpx;
  --type-body: 32rpx;
  --type-reference: calc(var(--type-body) - 2rpx);
  --type-section: 34rpx;
  --type-settings-item: 32rpx;
  --type-prompt: 34rpx;
  --type-daily-content-prompt: 36rpx;
  --type-title: 36rpx;
  --type-nav-title: 36rpx;
  --type-article-detail-title: 34rpx;
  --type-article-detail-meta: 28rpx;
  --type-metric: 38rpx;
  --type-home-stat-detail: 28rpx;
  --type-mine-stat-label: 26rpx;
  --type-checkin-reward: 28rpx;
  --type-checkin-summary: 26rpx;
  --line-height-content: 1.72;
  --history-article-title-line-height: 1.7;
  --history-audio-title-line-height: 1.5;
  --color-accent-fill: rgba(212, 154, 104, 0.32);
  --type-success: 40rpx;
  --type-hero: 44rpx;
  --type-audio-clock: 76rpx;
  --type-audio-meta: 26rpx;
  --type-calendar-date: 30rpx;
  --type-calendar-lunar: 22rpx;
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 40rpx;
  --space-6: 48rpx;
  --page-padding: var(--space-3);
  --tab-safe-padding: calc(112rpx + env(safe-area-inset-bottom) + var(--space-5));
  --card-radius: 16rpx;
  --media-radius: 12rpx;
  --card-gap: var(--space-3);
  --card-content-gap: 16rpx;
  /* Article reading rhythm: text paragraphs and media keep independent controls. */
  --article-content-gap: 20rpx;
  --article-media-gap: 24rpx;
  --article-media-start-gap: 10rpx;
  --article-media-end-gap: 32rpx;
  --card-meta-gap: 12rpx;
  --article-side-card-size: 168rpx;
  --article-side-title-height: 110rpx;
  --home-stat-card-min-height: 136rpx;
  --home-stat-padding-top: 16rpx;
  --home-stat-padding-bottom: 20rpx;
  --home-stat-content-gap: 12rpx;
  --home-stat-value-line-height: 1.25;
  --home-stat-label-line-height: 1.4;
  /* 卡片统一采用 20rpx，收窄边界并保留内容呼吸感。 */
  --card-padding-x: 20rpx;
  --card-padding-y: 20rpx;
  --content-gap: var(--space-3);
  --control-gap: var(--space-2);
  --action-gap: var(--space-2);
  --action-bar-padding-y: var(--space-1);
  --action-height: 72rpx;
  --action-icon-size: 34rpx;
  --line-height-card-meta: 1.5;
  --shadow-soft: 0 4rpx 16rpx rgba(105, 72, 42, 0.10);
  --shadow-strong: 0 20rpx 52rpx rgba(105, 72, 42, 0.11);
}

/* 较大模式同步放大互动文字、图标和按钮触控区域。 */
.theme.font-larger {
  --history-article-title-line-height: 1.5;
  --article-content-gap: 24rpx;
  --article-media-gap: 28rpx;
  --type-tab: 24rpx;
  --type-caption: 26rpx;
  --type-article-meta: 28rpx;
  --type-assist: 28rpx;
  --type-control: 32rpx;
  --type-action: 28rpx;
  --type-body: 36rpx;
  --type-section: 38rpx;
  --type-settings-item: 36rpx;
  --type-prompt: 38rpx;
  --type-daily-content-prompt: 40rpx;
  --type-title: 40rpx;
  --type-article-detail-title: 38rpx;
  --type-article-detail-meta: 30rpx;
  --type-metric: 40rpx;
  --type-home-stat-detail: 30rpx;
  --type-mine-stat-label: 28rpx;
  --type-checkin-reward: 30rpx;
  --type-checkin-summary: 28rpx;
  --type-success: 42rpx;
  --type-audio-meta: 28rpx;
  --type-calendar-date: 32rpx;
  --type-calendar-lunar: 24rpx;
  --article-side-card-size: 184rpx;
  --article-side-title-height: 124rpx;
  --action-height: 76rpx;
  --action-icon-size: 36rpx;
}

/* 最大模式提升阅读层级，辅助文字和控件只增加一档，避免界面膨胀。 */
.theme.font-max {
  --history-article-title-line-height: 1.35;
  --history-audio-title-line-height: 1.4;
  --article-content-gap: 28rpx;
  --article-media-gap: 32rpx;
  --type-tab: 26rpx;
  --type-caption: 28rpx;
  --type-article-meta: 30rpx;
  --type-assist: 30rpx;
  --type-control: 34rpx;
  --type-action: 30rpx;
  --type-body: 40rpx;
  --type-section: 42rpx;
  --type-settings-item: 40rpx;
  --type-prompt: 42rpx;
  --type-daily-content-prompt: 44rpx;
  --type-title: 44rpx;
  --type-article-detail-title: 42rpx;
  --type-article-detail-meta: 32rpx;
  --type-metric: 44rpx;
  --type-home-stat-detail: 34rpx;
  --type-mine-stat-label: 30rpx;
  --type-checkin-reward: 34rpx;
  --type-checkin-summary: 30rpx;
  --type-success: 46rpx;
  --type-hero: 48rpx;
  --type-audio-meta: 30rpx;
  --type-calendar-date: 34rpx;
  --type-calendar-lunar: 26rpx;
  --article-side-card-size: 200rpx;
  --article-side-title-height: 138rpx;
  --action-height: 80rpx;
  --action-icon-size: 40rpx;
}
