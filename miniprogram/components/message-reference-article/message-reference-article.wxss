@import '../../styles/message-reference.wxss';

.reference-article {
  --reference-article-cover-size: 104rpx;
  grid-template-columns: minmax(0, 1fr) var(--reference-article-cover-size);
  gap: var(--space-3);
}

.reference-article.history-article-layout--no-cover {
  grid-template-columns: minmax(0, 1fr);
}

.reference-article-media {
  width: var(--reference-article-cover-size);
  height: var(--reference-article-cover-size);
}

.reference-article-title {
  font-size: var(--type-reference);
}
