<view class="reference-card reference-album"><view class="history-album-wrap"><scroll-view wx:if="{{item.images.length}}" scroll-x class="history-image-grid" show-scrollbar="{{false}}"><view class="history-image-track"><view wx:for="{{item.images}}" wx:for-item="image" wx:for-index="imageIndex" wx:key="id" class="photo-card" data-index="{{imageIndex}}" bindtap="preview"><image class="entry-image history-album-image" mode="aspectFill" src="{{image.displayUrl}}"></image></view></view></scroll-view></view></view>
