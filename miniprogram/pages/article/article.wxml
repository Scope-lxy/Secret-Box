<view class="theme {{fontSizeMode === 'max' ? 'font-max' : (fontSizeMode === 'larger' ? 'font-larger' : '')}}">
  <immersive-nav back="{{true}}" backToHome="{{true}}" interceptBack="{{returnToArticles}}" bindback="handleArticleBack" showTitle="{{true}}" title="文章详情" refreshing="{{refreshing}}"></immersive-nav>
  <view class="page plain-page article-page">
    <view wx:if="{{ready}}" class="article-main">
      <view class="article-intro">
        <view class="article-header">
          <text class="article-title">{{article.title}}</text>
          <view wx:if="{{article.author || article.publishedAtText}}" class="article-card-meta article-header-meta">
            <text class="article-card-author">{{article.author || '轻读手记'}}</text>
            <text wx:if="{{article.publishedAtText}}" class="article-published-at">{{article.publishedAtText}}</text>
          </view>
        </view>

      </view>

      <view class="article-flow">
        <view class="article-body-followup">
          <view class="article-media-flow">
              <view wx:if="{{ads.articlesStartNative.enabled && ads.articlesStartNative.adUnitId}}" hidden="{{startAdHidden}}" class="article-ad article-media-block article-media-block--pure article-media-block--media-start article-media-block--media-end {{startAdHidden ? 'article-media-block--hidden' : ''}}">
              <ad-custom unit-id="{{ads.articlesStartNative.adUnitId}}" data-position="start" bindload="handleNativeAdLoad" binderror="handleNativeAdError"></ad-custom>
            </view>

            <block wx:if="{{unlockedToday && article.bodySegments.length}}">
              <block wx:for="{{article.bodySegments}}" wx:key="index">
                <rich-text wx:if="{{item.type == 'html'}}" class="article-rich-text {{item.mediaOnly ? 'article-media-block article-media-block--pure' : ''}} {{item.startsWithMedia ? 'article-media-block--media-start' : 'article-media-block--text-start'}} {{item.endsWithMedia ? 'article-media-block--media-end' : 'article-media-block--text-end'}}" nodes="{{item.html}}"></rich-text>
                <view wx:elif="{{item.type == 'middle-ad' && ads.articlesEndNative.enabled && ads.articlesEndNative.adUnitId}}" hidden="{{middleAdHidden}}" class="article-ad article-media-block article-media-block--pure article-media-block--media-start article-media-block--media-end {{middleAdHidden ? 'article-media-block--hidden' : ''}}">
                  <ad-custom unit-id="{{ads.articlesEndNative.adUnitId}}" data-position="middle" bindload="handleNativeAdLoad" binderror="handleNativeAdError"></ad-custom>
                </view>
              </block>
            </block>
            <rich-text wx:elif="{{unlockedToday}}" class="article-rich-text {{article.bodyMediaOnly ? 'article-media-block article-media-block--pure' : ''}} {{article.bodyStartsWithMedia ? 'article-media-block--media-start' : 'article-media-block--text-start'}} {{article.bodyEndsWithMedia ? 'article-media-block--media-end' : 'article-media-block--text-end'}}" nodes="{{article.bodyHtml}}"></rich-text>
            <view wx:else class="article-preview-wrap">
              <view class="article-preview" style="max-height: {{previewMaxHeightVh}}vh;">
                <rich-text class="article-rich-text" nodes="{{article.previewHtml}}"></rich-text>
              </view>
              <view class="article-preview-fade"></view>
              <button class="button-primary article-expand {{unlocking ? 'is-loading' : ''}}" disabled="{{unlocking}}" bindtap="expandArticle">
                <view wx:if="{{unlocking}}" class="button-loading-dots button-loading-dots--light"><view></view><view></view><view></view></view>
                <text wx:else>{{expandButtonText}}</text>
              </button>
            </view>

            <view wx:if="{{unlockedToday && ads.articlesEndNative.enabled && ads.articlesEndNative.adUnitId}}" hidden="{{endAdHidden}}" class="article-ad article-media-block article-media-block--pure article-media-block--media-start article-media-block--media-end {{endAdHidden ? 'article-media-block--hidden' : ''}}">
              <ad-custom unit-id="{{ads.articlesEndNative.adUnitId}}" data-position="end" bindload="handleNativeAdLoad" binderror="handleNativeAdError"></ad-custom>
            </view>
          </view>
          <view class="article-interactions action-bar-surface">
            <view class="action-bar">
              <button class="action-pill action-button {{article.liked ? 'active' : ''}}" hover-class="action-pill--pressed" aria-disabled="{{interactionLoading}}" aria-label="{{article.liked ? '取消点赞' : '点赞'}}" bindtap="toggleLike"><image class="action-icon" src="{{article.liked ? '/assets/icons/action-heart-active.svg' : '/assets/icons/action-heart.svg'}}"></image><text>{{article.displayLikeCount || '点赞'}}</text></button>
              <button class="action-pill action-button {{article.favorited ? 'active' : ''}}" hover-class="action-pill--pressed" aria-disabled="{{interactionLoading}}" aria-label="{{article.favorited ? '取消收藏' : '收藏'}}" bindtap="toggleFavorite"><image class="action-icon" src="{{article.favorited ? '/assets/icons/action-bookmark-active.svg' : '/assets/icons/action-bookmark.svg'}}"></image><text>{{article.displayFavoriteCount || '收藏'}}</text></button>
              <button wx:if="{{messagesEnabled}}" class="action-pill action-button" hover-class="action-pill--pressed" aria-label="留言" bindtap="toggleArticleMessage"><image class="action-icon" src="/assets/icons/action-message.svg"></image><text>留言</text></button>
              <button class="action-pill action-button" open-type="share" data-share="article" aria-label="分享"><image class="action-icon" src="/assets/icons/action-share.svg"></image><text>分享</text></button>
            </view>
            <view wx:if="{{messagesEnabled && article.myMessage}}" class="message-box">
              <view class="message-box-header">
                <text class="message-label">我的留言</text>
                <text class="message-label message-delete {{messageDeleting ? 'is-disabled' : ''}}" aria-role="button" aria-label="{{messageDeleting ? '正在删除留言' : '删除留言'}}" aria-disabled="{{messageDeleting}}" bindtap="handleDeleteMessage">删除</text>
              </view>
              <text class="message-text">{{article.myMessage}}</text>
            </view>
            <view wx:if="{{messagesEnabled && articleMessageVisible}}" class="message-box">
              <textarea class="message-input" auto-height maxlength="-1" placeholder="写下你想说的话…" placeholder-class="message-input-placeholder" value="{{messageText}}" bindinput="handleMessageInput"></textarea>
              <view class="message-input-row">
                <text class="message-label">留言仅你和对方可见</text>
                <button class="message-submit {{messageSubmitting ? 'is-loading' : ''}}" aria-label="{{messageSubmitting ? '正在提交留言' : '确认留言'}}" disabled="{{messageSubmitting || messageDeleting || !messageText.length}}" bindtap="handleSubmitMessage"><view wx:if="{{messageSubmitting}}" class="button-loading-dots button-loading-dots--light"><view></view><view></view><view></view></view><text wx:else>确认</text></button>
              </view>
            </view>
          </view>
        </view>

        <view wx:if="{{recommendations.length}}" class="recommend-section">
          <text class="recommend-title">继续阅读</text>
          <view class="recommend-list">
            <block wx:for="{{recommendations}}" wx:key="id">
              <view class="article-card article-card--{{item.cardLayout}} {{item.coverUrl ? '' : 'article-card--no-cover'}}" data-id="{{item.id}}" hover-class="article-card--pressed" bindtap="openRecommendation">
                <view wx:if="{{item.coverUrl}}" class="article-card-media">
                  <image class="article-card-cover" src="{{item.coverUrl}}" mode="aspectFill" lazy-load="{{true}}" data-index="{{index}}" data-src="{{item.coverUrl}}" binderror="handleRecommendationCoverError"></image>
                  <view wx:if="{{item.cardLayout == 'stacked' && (item.author || item.likeCount || item.favoriteCount)}}" class="article-card-media-gradient"></view>
                  <view wx:if="{{item.cardLayout == 'stacked' && (item.author || item.likeCount || item.favoriteCount)}}" class="article-card-meta article-card-meta--overlay">
                    <text wx:if="{{item.author}}" class="article-card-author">{{item.author}}</text>
                    <view wx:if="{{item.likeCount}}" class="article-card-stat" aria-label="点赞 {{item.likeCount}}"><text>赞 {{item.likeCount}}</text></view>
                    <view wx:if="{{item.favoriteCount}}" class="article-card-stat" aria-label="收藏 {{item.favoriteCount}}"><text>藏 {{item.favoriteCount}}</text></view>
                  </view>
                </view>
                <view class="article-card-copy">
                  <text class="article-card-title">{{item.title}}</text>
                  <view wx:if="{{item.cardLayout == 'title-left' || !item.coverUrl}}" class="article-card-meta">
                    <text class="article-card-author">{{item.author || '轻读手记'}}</text>
                    <view wx:if="{{item.likeCount}}" class="article-card-stat" aria-label="点赞 {{item.likeCount}}"><text>赞 {{item.likeCount}}</text></view>
                    <view wx:if="{{item.favoriteCount}}" class="article-card-stat" aria-label="收藏 {{item.favoriteCount}}"><text>藏 {{item.favoriteCount}}</text></view>
                  </view>
                </view>
              </view>
              <view wx:if="{{item.showNativeAdAfter && ads.articlesEndNative.enabled && ads.articlesEndNative.adUnitId}}" hidden="{{recommendationAdHidden}}" style="{{recommendationAdHidden ? 'display:none;' : ''}}" class="card article-ad recommendation-ad">
                <ad-custom unit-id="{{ads.articlesEndNative.adUnitId}}" data-position="recommendation" bindload="handleNativeAdLoad" binderror="handleNativeAdError"></ad-custom>
              </view>
            </block>
          </view>
          <view wx:if="{{recommendationLoading}}" class="muted recommendation-loading">正在加载更多</view>
        </view>
      </view>
    </view>

    <loading-state wx:if="{{loading}}" rows="3" row-width="42%, 100%, 92%" label="正在加载"></loading-state>
    <view wx:if="{{error && !loading}}" class="card state-card"><text class="muted">{{error}}</text></view>
  </view>
  <view wx:if="{{phoneSyncPromptVisible}}" class="phone-sync-prompt-overlay" catchtouchmove="preventPhoneSyncPromptScroll">
    <view class="phone-sync-prompt-sheet" role="dialog" aria-modal="true" aria-label="同步你的记录">
      <view class="phone-sync-prompt-copy">
        <text class="phone-sync-prompt-title">手机号快捷登录</text>
        <text class="phone-sync-prompt-text">完成手机号快捷登录后，可在多个小程序中同步你的记录。</text>
      </view>
      <view class="phone-sync-prompt-actions">
        <button class="phone-sync-prompt-button phone-sync-prompt-decline" disabled="{{phoneSyncAuthorizing}}" bindtap="handlePhoneSyncDecline">暂不</button>
        <button class="phone-sync-prompt-button phone-sync-prompt-authorize" loading="{{phoneSyncAuthorizing}}" disabled="{{phoneSyncAuthorizing}}" open-type="getPhoneNumber" bindgetphonenumber="handlePhoneSyncAuthorize">同意并继续</button>
      </view>
    </view>
  </view>
  <canvas id="shareCanvas" canvas-id="shareCanvas" type="2d" class="share-card-canvas"></canvas>
</view>
