.article-feed {
  gap: var(--card-gap);
}

.article-card {
  box-sizing: border-box;
  min-width: 0;
  display: grid;
  gap: var(--card-content-gap);
  padding: var(--card-padding-y) var(--card-padding-x);
  overflow: hidden;
  border: 1rpx solid var(--color-line);
  border-radius: var(--card-radius);
  background: var(--color-card);
  box-shadow: var(--shadow-soft);
  transition: transform 0.16s ease, background-color 0.16s ease, box-shadow 0.16s ease;
}

.article-card--pressed {
  background: var(--color-card-soft);
  box-shadow: 0 4rpx 12rpx rgba(105, 72, 42, 0.06);
  transform: scale(0.985);
}

.article-card--title-left {
  grid-template-columns: minmax(0, 1fr) var(--article-side-card-size);
  align-items: start;
}

.article-card--title-left .article-card-copy {
  grid-column: 1;
  grid-row: 1;
  height: var(--article-side-card-size);
  justify-content: space-between;
  gap: 0;
}

.article-card--title-left .article-card-media {
  grid-column: 2;
  grid-row: 1;
  width: var(--article-side-card-size);
  height: var(--article-side-card-size);
}

.article-card--stacked {
  grid-template-columns: minmax(0, 1fr);
}

.article-card--no-cover {
  grid-template-columns: minmax(0, 1fr);
  min-height: 152rpx;
}

.article-card--no-cover .article-card-copy {
  grid-column: 1;
  grid-row: 1;
}

.article-card--stacked .article-card-media {
  grid-column: 1;
  grid-row: 1;
  width: 100%;
  aspect-ratio: 2.35 / 1;
}

.article-card--stacked .article-card-copy {
  grid-column: 1;
  grid-row: 2;
}

.article-card--stacked.article-card--no-cover .article-card-copy {
  grid-row: 1;
}

.article-card-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: var(--space-2);
}

.article-card-title {
  display: -webkit-box;
  overflow: hidden;
  color: var(--color-text);
  font-size: var(--type-body);
  font-weight: 400;
  line-height: var(--line-height-content);
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.article-card--title-left .article-card-title {
  height: var(--article-side-title-height);
}

.article-card-meta {
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  gap: var(--space-2);
  overflow: hidden;
  color: var(--color-text-secondary);
  font-size: var(--type-article-meta);
  font-weight: 400;
  line-height: var(--line-height-card-meta);
  white-space: nowrap;
}

.article-card-author {
  max-width: 10em;
  overflow: hidden;
  color: var(--color-text-secondary);
  font-weight: 400;
  text-overflow: ellipsis;
}

.article-card-stat {
  min-width: 0;
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  font-weight: 400;
  white-space: nowrap;
}

.article-card-cover {
  box-sizing: border-box;
  width: var(--article-side-card-size);
  height: var(--article-side-card-size);
  align-self: center;
  border-radius: var(--media-radius);
  background: var(--color-card-soft);
}

.article-card-media {
  position: relative;
  min-width: 0;
  overflow: hidden;
  border-radius: var(--media-radius);
  background: var(--color-card-soft);
}

.article-card-media .article-card-cover {
  position: absolute;
  top: 0;
  left: 0;
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 0;
}

.article-card-media-gradient {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 46%;
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0), rgba(35, 24, 15, 0.72));
}

.article-card-meta--overlay {
  position: absolute;
  right: var(--space-2);
  bottom: var(--space-2);
  left: var(--space-2);
  z-index: 1;
  color: rgba(255, 255, 255, 0.86);
}

.article-card-meta--overlay .article-card-author,
.article-card-meta--overlay .article-card-stat {
  color: rgba(255, 255, 255, 0.86);
}

.article-card-meta--overlay .article-card-author {
  font-weight: 400;
}
